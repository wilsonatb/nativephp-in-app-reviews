{
    "name": "wilsonatb/nativephp-in-app-reviews",
    "description": "In-App Reviews API",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Wilson Tovar",
            "email": "diwdesign.wilson@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nativephp\\InAppReviews\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nativephp\\InAppReviews\\InAppReviewsServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
